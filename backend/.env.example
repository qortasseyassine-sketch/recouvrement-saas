# ===========================
# SERVEUR
# ===========================
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ===========================
# SÉCURITÉ JWT
# ===========================
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d

# ===========================
# BASE DE DONNÉES (SQLite)
# ===========================
DB_PATH=./database.db

# ===========================
# EMAIL (Nodemailer)
# Option 1: Gmail (développement)
# Option 2: SendGrid (production)
# ===========================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre@gmail.com
EMAIL_PASS=votre_app_password_gmail
EMAIL_FROM="RecouvrementPro <votre@gmail.com>"

# Pour SendGrid (production) :
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=SG.votre_cle_sendgrid

# ===========================
# STRIPE
# ===========================
STRIPE_SECRET_KEY=sk_test_votre_cle_stripe
STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_stripe
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret

# ===========================
# TWILIO (optionnel - SMS)
# ===========================
# TWILIO_ACCOUNT_SID=ACxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxx
# TWILIO_PHONE_NUMBER=+33xxxxxxxxx

# ===========================
# ADMIN
# ===========================
ADMIN_EMAIL=admin@votredomaine.com
ADMIN_PASSWORD=change_this_strong_password
